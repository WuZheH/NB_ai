# Search does not load this file automatically. Copy values into the current
# process environment or use the PowerShell scripts documented in README.md.

# User data. Relative paths are resolved from the repository/runtime root.
SEARCH_DATA_DIR=.\data
SEARCH_ZOTERO_DATA_DIR=

# Required executables for the self-contained desktop runtime.
SEARCH_PYTHON=
SEARCH_NODE=

# Optional HTTPS tunnel client used only for ChatGPT App development.
SEARCH_CLOUDFLARED=
SEARCH_TUNNEL_STATE_DIR=.\.codex_tmp\quick-tunnel

# Loopback services.
SEARCH_BACKEND_PORT=8000
SEARCH_MCP_PORT=8787
SEARCH_BACKEND_URL=http://127.0.0.1:8000
SEARCH_FRONTEND_URL=http://127.0.0.1:5173
SEARCH_RUNTIME_MODE=local

# MCP Developer Mode only. Never use the unauthenticated gate as a permanent
# internet-facing deployment. Leave optional credentials empty in examples.
SEARCH_ALLOW_UNAUTHENTICATED_MCP_DEV=
SEARCH_BACKEND_BEARER_TOKEN=
SEARCH_WIDGET_DOMAIN=
SEARCH_MCP_INSPECTOR=
SEARCH_SMOKE_SOURCE_TYPES=zotero_inspiration_note

# Optional directory overrides. Defaults are documented in README.md:
# runtime/logs under %LOCALAPPDATA%\Search, config under %APPDATA%\Search.
SEARCH_RUNTIME_DIR=
SEARCH_LOG_DIR=
SEARCH_CONFIG_DIR=

# Optional local model locations. No model is downloaded automatically.
SEARCH_MODEL_CACHE_DIR=.\data\models
SEARCH_EMBEDDING_MODEL=
SEARCH_RERANKER_MODEL=
SEARCH_MARKER_MODEL_CACHE=
