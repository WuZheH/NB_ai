{
  "name": "search-desktop",
  "productName": "Search",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "electron/main/index.js",
  "scripts": {
    "start": "electron .",
    "desktop:dev": "electron .",
    "build:renderer": "npm --prefix ../../frontend run build",
    "package:win:unpacked": "node scripts/package-windows-unpacked.mjs",
    "package:candidate:r3": "node scripts/package-r3-candidate.mjs",
    "package:candidate:r4": "node scripts/package-r4-candidate.mjs",
    "package:candidate:reuse-runtime": "node scripts/package-candidate-from-existing-runtime.mjs",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged-search.ps1",
    "build": "npm run build:renderer && npm run check && npm run package:win:unpacked",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check electron/main/index.js && node --check electron/main/application.js && node --check electron/main/window.js && node --check electron/preload/index.cjs && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "rcedit": "5.0.2"
  },
  "build": {
    "appId": "local.search.desktop",
    "productName": "Search",
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "scripts/**/*.ps1",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../frontend/dist",
        "to": "search-assets/frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../packages/search-design-system/src",
        "to": "search-assets/design-system",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "executableName": "Search",
      "icon": "assets/search.ico",
      "signAndEditExecutable": false
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
