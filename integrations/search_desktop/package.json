{
  "name": "search-desktop",
  "productName": "Search",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "electron/main/index.js",
  "scripts": {
    "start": "electron .",
    "desktop:dev": "electron .",
    "build:renderer": "npm --prefix ../../frontend run build",
    "build:mcp-runtime": "node ../notebook_ai_chatgpt_app/scripts/build-widget.mjs && node ../notebook_ai_chatgpt_app/scripts/build-server.mjs",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged-search.ps1",
    "build": "npm run build:renderer && npm run build:mcp-runtime && npm run check",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check electron/main/index.js && node --check electron/main/application.js && node --check electron/main/window.js && node --check electron/preload/index.cjs && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "rcedit": "5.0.2"
  },
  "build": {
    "appId": "local.search.desktop",
    "productName": "Search",
    "asar": false,
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "!electron/product-metadata.json",
      "renderer/**/*",
      "scripts/**/*.ps1",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../frontend/dist",
        "to": "search-assets/frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../packages/search-design-system/src",
        "to": "search-assets/design-system",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../app",
        "to": "app/runtime-project/app",
        "filter": [
          "**/*.py",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../../scripts/runtime/notebook_ai_launcher.py",
        "to": "app/runtime-project/scripts/runtime/notebook_ai_launcher.py"
      },
      {
        "from": "../../scripts/index/status_zotero_note_vectors.py",
        "to": "app/runtime-project/scripts/index/status_zotero_note_vectors.py"
      },
      {
        "from": "../../scripts/index/sync_zotero_note_vectors.py",
        "to": "app/runtime-project/scripts/index/sync_zotero_note_vectors.py"
      },
      {
        "from": "../../scripts",
        "to": "app/runtime-project/scripts",
        "filter": [
          "__init__.py",
          "configure_search_machine.py",
          "configure_search_machine.ps1",
          "import_book_ocr_layout_first.py",
          "importing/import_book_ocr_layout_first.py",
          "phase110k_p_b_alignment_writeback_plan.py",
          "phase110k_p_c_import_time_alignment_batch_dry_run.py",
          "phase110k_p_d_import_alignment_hook_dry_run.py",
          "phase110k_p_f_batch_alignment_writeback_apply.py",
          "phase110k_p_inspiration_match_readiness_dry_run.py",
          "maintenance/reconcile_search_book_deletion.py",
          "maintenance/smoke_search_book_deletion_isolated.py",
          "zotero/phase110k_p_b_alignment_writeback_plan.py",
          "zotero/phase110k_p_c_import_time_alignment_batch_dry_run.py",
          "zotero/phase110k_p_d_import_alignment_hook_dry_run.py",
          "zotero/phase110k_p_f_batch_alignment_writeback_apply.py",
          "zotero/phase110k_p_inspiration_match_readiness_dry_run.py"
        ]
      },
      {
        "from": "../../config/retrieval_query_aliases.json",
        "to": "app/runtime-project/config/retrieval_query_aliases.json"
      },
      {
        "from": "../notebook_ai_chatgpt_app/dist/server/index.js",
        "to": "app/runtime-project/integrations/notebook_ai_chatgpt_app/dist/server/index.js"
      },
      {
        "from": "../notebook_ai_chatgpt_app/dist/server/build-manifest.json",
        "to": "app/runtime-project/integrations/notebook_ai_chatgpt_app/dist/server/build-manifest.json"
      },
      {
        "from": "../notebook_ai_chatgpt_app/web/dist/widget.html",
        "to": "app/runtime-project/integrations/notebook_ai_chatgpt_app/web/dist/widget.html"
      },
      {
        "from": "../notebook_ai_chatgpt_app/package.json",
        "to": "app/runtime-project/integrations/notebook_ai_chatgpt_app/package.json"
      }
    ],
    "win": {
      "executableName": "Search",
      "icon": "assets/search.ico",
      "signAndEditExecutable": false
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
