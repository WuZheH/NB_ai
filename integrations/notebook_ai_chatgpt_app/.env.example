# Search backend. Plain HTTP is accepted only for a loopback host.
SEARCH_BACKEND_URL=http://127.0.0.1:8000

# Required for the first, explicitly unauthenticated Developer Mode build.
# Never leave this enabled on an internet-facing host.
SEARCH_ALLOW_UNAUTHENTICATED_MCP_DEV=1

# MCP listens on loopback only. An HTTPS tunnel may forward to this port.
SEARCH_MCP_PORT=8787

# Optional backend credential extension point. Do not commit a real value.
# SEARCH_BACKEND_BEARER_TOKEN=

# Explicit PDF Inbox used by fileParams staging and the manual fallback.
# SEARCH_IMPORT_INBOX=

# Actions fallback only. Do not enable these when using the READ App.
# SEARCH_ACTIONS_PUBLIC_BASE_URL=https://search-actions.example.com
# SEARCH_ACTIONS_BEARER_TOKEN=

# Fixed dedicated widget origin:
# https://read-library-widget.openaiusercontent.com
